# ============================================================
#  Modèle de configuration — copie ce fichier en `.env`
#  et remplis les valeurs réelles. Ne JAMAIS commiter `.env`.
# ============================================================

# --- Base de données PostgreSQL / PostGIS ---
# Format: postgresql+pg8000://user:password@host:port/dbname?options=...
DATABASE_URL=postgresql+pg8000://user:password@localhost:5432/watertracker

# --- Sécurité API ---
# Clé API requise pour les endpoints d'écriture (/admin, /predict, collecte)
API_KEY=change-me-in-production
# Origines CORS autorisées (séparées par des virgules). Laisse vide pour les désactiver.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Services externes ---
GROQ_API_KEY=
# Modèle Groq utilisé pour les recommandations
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTE_API_KEY=

# --- Google Earth Engine ---
# ID du projet GCP sur lequel Earth Engine est initialisé
GEE_PROJECT=water-492400
# Serveur uniquement : clé de compte de service Earth Engine (chemin du .json ou contenu JSON).
# En local, laisser vide et utiliser `earthengine authenticate`.
GEE_SERVICE_ACCOUNT_KEY=
# Zone de surveillance (centroïde, en degrés) + rayon en mètres
WATCH_CENTER_LAT=12.3647
WATCH_CENTER_LNG=-1.5221
WATCH_RADIUS_M=50000

# --- Scheduler ---
# Activer le scheduler APScheduler (true/false)
SCHEDULER_ENABLED=false
# Vérification de la mise à jour mensuelle v3 toutes les N heures (168 = chaque semaine).
# Idempotente : un mois n'est collecté qu'une fois, dès sa publication par ERA5-Land/CHIRPS.
COLLECT_HOURS=168

# --- Modèle v3 ---
# Seuil de niveau critique (part de la surface de référence). Doit être celui de
# l'entraînement (CRITICAL_FILL dans le notebook) ; le changer impose de ré-entraîner.
CRITICAL_FILL=0.20
